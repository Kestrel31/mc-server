# RCON (shared between mc, rcon-web, mc-backup) — Java files only
RCON_PASSWORD=changeme-rcon

# RCON Web Admin panel login — Java files only
RCON_WEB_ADMIN_USER=admin
RCON_WEB_ADMIN_PASSWORD=changeme-web

# FileBrowser login — both editions
FILEBROWSER_USER=admin
FILEBROWSER_PASSWORD=changeme-filebrowser

# playit.gg tunnel agent secret — only needed for the *.playit.yml files
PLAYIT_SECRET_KEY=
