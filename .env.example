# RCON password — used internally by mc (ENABLE_RCON) and mc-backup to
# safely pause world-saving during backups. Not exposed via any web UI
# in this stack (RCON Web Admin was removed — see docs/decisions.md).
RCON_PASSWORD=admin

# playit.gg tunnel agent secret — only needed for the *.playit.yml files
PLAYIT_SECRET_KEY=

# NOTE: FileBrowser's admin username/password are set in
# filebrowser.config.yaml (not here) — see that file directly, or change
# the password after first login with:
#   docker exec filebrowser filebrowser user set admin <new-password>
